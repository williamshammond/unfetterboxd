{
  "manifest_version": 3,
  "name": "Visible Ratings for Letterboxd",
  "version": "0.1.0",
  "description": "Shows existing Letterboxd ratings directly on list pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://letterboxd.com/*/list/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
